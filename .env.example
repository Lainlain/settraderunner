# App key and secret from your broker's Settrade Open API console.
SETTRADE_APP_ID=
SETTRADE_APP_SECRET=

# Sandbox uses app code SANDBOX and broker id SANDBOX.
# The SDK maps broker id SANDBOX to broker 098 on the UAT hosts.
# Live trading uses your broker id and app code ALGO.
SETTRADE_APP_CODE=SANDBOX
SETTRADE_BROKER_ID=SANDBOX

# Equity account. Sandbox accounts are often "{username}-E".
SETTRADE_ACCOUNT_NO=

# Derivatives account. Sandbox accounts are often "{username}-D".
SETTRADE_DERIV_ACCOUNT_NO=
